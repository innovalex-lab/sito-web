---
// Lastra del nuovo contatto (Ordine Operativo, fase 4 sessione 2). Stesso materiale e stessi mattoni delle altre lastre.
// Arriva una mail da un mittente che non è in anagrafica; il pannello lo segnala come possibile nuovo cliente;
// con un click si apre la pratica; esito: cliente creato, pratica aperta, cartella pronta. Dati fittizi.
// Una sola animazione: la sequenza interna, quando la lastra entra nello schermo (data-stato da futura ad attiva).
interface Props {
  stato?: string;
  class?: string;
}
const { stato, class: classi = '' } = Astro.props;
const campi = [
  { etichetta: 'Nuovo cliente', valore: 'Conti Trasporti Srl' },
  { etichetta: 'Pratica', valore: 'Contratto di fornitura' },
];
const esito = ['Cliente creato', 'Pratica aperta', 'Cartella pronta'];
---
<div class:list={['lastra', classi]} data-stato={stato} data-ui>
  <div class="vetro" aria-hidden="true"><span class="spigolo spigolo-basso"></span><span class="spigolo spigolo-sx"></span><span class="spigolo spigolo-dx"></span></div>
  <div class="carta nc" role="img" aria-label="Arriva una mail da Davide Conti, Conti Trasporti Srl, che non è in anagrafica. Il pannello INNOVALEX lo segnala come possibile nuovo cliente; con Apri pratica si crea il cliente, si apre la pratica Contratto di fornitura e la cartella è pronta.">
    <div class="nc-mail">
      <p class="ol-oggetto">Richiesta di consulenza</p>
      <div class="ol-da">
        <span class="ui-avatar">DC</span>
        <span><b>Davide Conti</b><small>Conti Trasporti Srl, oggi alle 11:05</small></span>
      </div>
      <p class="nc-testo">Buongiorno Avvocata, ci serve un parere sul contratto di fornitura con un nuovo distributore. Possiamo sentirci questa settimana?</p>
      <span class="ui-file"><i>PDF</i><span>bozza_contratto.pdf</span></span>
    </div>
    <div class="nc-pannello">
      <div class="pn-testa">
        <img src="/brand/innovalex-logo.svg" width="82" height="25" alt="" />
        <span class="pn-utente">Sara Lombrici</span>
      </div>
      <div class="nc-avviso a-scende">
        <b>Mittente non in anagrafica</b>
        <span>Possibile nuovo cliente</span>
      </div>
      {campi.map((c, i) => (
        <div class="pn-campo" style={`--n:${i}`}>
          <span class="pn-etichetta">{c.etichetta}</span>
          <span class="pn-valore"><span class="a-compila">{c.valore}</span></span>
        </div>
      ))}
      <div class="nc-azione">
        <span class="pn-conferma a-premi">Apri pratica</span>
        <ul class="nc-esito a-fatto">
          {esito.map((e, i) => (
            <li>{i === 2 ? <span class="ct-icona" aria-hidden="true"></span> : <span class="ui-spunta"></span>}{e}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</div>
