---
// Lastra 3: la mail diventa PDF nella cartella di cliente e pratica. Dati fittizi.
interface Props {
  stato?: string;
  class?: string;
}
const { stato, class: classi = '' } = Astro.props;
const file = [
  { n: '013', nome: '2026-11-07_013_Foto-cantiere_Rossi.pdf', orig: 'IMG_2231.pdf' },
  { n: '012', nome: '2026-11-04_012_Contratto-appalto_Edilvetta.pdf', orig: 'contratto firmato.pdf' },
  { n: '011', nome: '2026-10-28_011_Mandato-professionale_Rossi.pdf', orig: 'mandato.pdf' },
];
---
<div class:list={['lastra', classi]} data-stato={stato} data-ui>
  <div class="vetro" aria-hidden="true"><span class="spigolo spigolo-basso"></span><span class="spigolo spigolo-sx"></span><span class="spigolo spigolo-dx"></span></div>
  <div class="carta ct" role="img" aria-label="Cartella Rossi Srl, pratica Rossi c. Edilvetta: la mail entra come PDF numero 014, dopo i documenti 011, 012 e 013.">
    <div class="ct-testa">
      <span class="ct-icona" aria-hidden="true"></span>
      <span class="ct-percorso">Clienti <i>/</i> Rossi Srl <i>/</i> <b>Rossi Srl c. Edilvetta</b></span>
    </div>
    <div class="ct-colonne"><span>Allegati</span><span>Rinominati e numerati per pratica</span></div>
    <div class="ct-elenco">
      <div class="ct-riga ct-nuova a-scende">
        <span class="ct-numero">014</span>
        <span class="ct-nome">2026-11-12_014_Email_Diffida_Edilvetta.pdf<small>mail di Marta Rossi, 12 nov 2026</small></span>
      </div>
      {file.map((f) => (
        <div class="ct-riga a-scivola">
          <span class="ct-numero">{f.n}</span>
          <span class="ct-nome">{f.nome}<small>originale: {f.orig}</small></span>
        </div>
      ))}
    </div>
    <p class="ct-piede"><span class="ui-spunta"></span>Mail e allegato archiviati in PDF</p>
  </div>
</div>
