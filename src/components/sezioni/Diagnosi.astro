---
// Diagnosi (ex chiusura del prototipo: stesso titolo e stesso stile), FAQ e piè di pagina.
// Il form NON è qui: si costruisce in una sessione dedicata. Al suo posto un segnaposto
// con le dimensioni del form futuro (campi del piano, sezione F.11), senza invii.
import { faq, faqSottotitolo } from '../../content/funzioni';

const campi = ['Nome e cognome', 'Studio', 'Email', 'Telefono', 'Ruolo', 'Persone nello studio', 'Priorità principale'];
---
<section id="contatti" class="chiusura diagnosi" aria-labelledby="t-chiusura">
  <div class="contenitore chiusura-interno diagnosi-interno">
    <div class="diagnosi-testo">
      <h2 id="t-chiusura" class="sezione-titolo">Vediamo il tuo studio in 30 minuti.</h2>
      <p class="chiusura-testo">In 30 minuti guardiamo come lo studio gestisce posta, documenti, pratiche e ore. Alla fine sai cosa si può sistemare e da dove partire.</p>
    </div>

    <div class="form-segnaposto" role="note" aria-label="Form della diagnosi (sessione dedicata)">
      <div class="fs-campi" aria-hidden="true">
        {campi.map((c) => (
          <span class="fs-campo"><span class="fs-etichetta">{c}</span><span class="fs-casella"></span></span>
        ))}
        <span class="fs-consenso"><span class="fs-spunta"></span><span class="fs-etichetta">Consenso privacy</span></span>
        <span class="fs-pulsante"></span>
      </div>
      <p class="fs-scritta">Form della diagnosi (sessione dedicata)</p>
    </div>
  </div>

  <div id="faq" class="contenitore faq">
    <div class="faq-testa">
      <h2 class="faq-titolo">Domande frequenti</h2>
      <p class="faq-sottotitolo">{faqSottotitolo}</p>
    </div>
    <div class="faq-elenco">
      {faq.map((f) => (
        <details class="faq-voce">
          <summary>{f.d}</summary>
          <p>{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
