---
// 9. Analisi gratuita (fino al 25/11/2026 "Diagnosi Operativa") e 10. FAQ. Testi e campi del form dal sito attuale
// (index.html su main, dopo 58e6b05). I nomi interni (file, classi, data-diagnosi, data-cta) restano quelli di prima.
// Il form invia a /api/lead con lo stesso formato di main (src/scripts/diagnosi.ts; api/lead.js non cambia).
// Etichette sempre visibili, errori accanto al campo, consenso privacy non preselezionato.
// Dopo l'invio: la conferma del piano al posto del form. Con un errore il form resta compilato.
import { faq, faqSottotitolo } from '../../content/funzioni';
import { diagnosi as d } from '../../content/storia';

const f = d.form;
const campo = (id: string) => ({ id, 'aria-describedby': `err-${id}` });
---
<section id="contatti" class="chiusura diagnosi" aria-labelledby="t-chiusura">
  <div class="contenitore chiusura-interno diagnosi-interno">
    <div class="diagnosi-testo">
      <p class="etichetta" data-uguale>{d.etichetta}</p>
      <h2 id="t-chiusura" class="sezione-titolo" data-modificato="25/11">{d.titolo[0]}<br />{d.titolo[1]}</h2>
      {d.testo.map((t) => <p class="chiusura-testo" data-uguale>{t}</p>)}
    </div>

    <div class="modulo-area" data-diagnosi>
      <form id="lead-form" class="modulo" novalidate autocomplete="on" data-diagnosi-form>
        <div class="mo-griglia">
          <div class="mo-campo">
            <label for="name" data-uguale>{f.nome.etichetta}</label>
            <input {...campo('name')} name="name" type="text" autocomplete="name" placeholder={f.nome.segnaposto} required />
            <p class="mo-errore" id="err-name" hidden>{f.nome.errore}</p>
          </div>
          <div class="mo-campo">
            <label for="studio" data-uguale>{f.studio.etichetta}</label>
            <input {...campo('studio')} name="studio" type="text" autocomplete="organization" required />
            <p class="mo-errore" id="err-studio" hidden>{f.studio.errore}</p>
          </div>
          <div class="mo-campo">
            <label for="email" data-uguale>{f.email.etichetta}</label>
            <input {...campo('email')} name="email" type="email" autocomplete="email" inputmode="email" placeholder={f.email.segnaposto} required />
            <p class="mo-errore" id="err-email" hidden>{f.email.errore}</p>
          </div>
          <div class="mo-campo">
            <label for="phone">{f.telefono.etichetta} <span class="mo-facoltativo">{f.telefono.facoltativo}</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder={f.telefono.segnaposto} />
          </div>
          <div class="mo-campo">
            <label for="role" data-uguale>{f.ruolo.etichetta}</label>
            <select {...campo('role')} name="role" required>
              <option value="">{f.ruolo.vuoto}</option>
              {f.ruolo.opzioni.map((o) => <option value={o}>{o}</option>)}
            </select>
            <p class="mo-errore" id="err-role" hidden>{f.ruolo.errore}</p>
          </div>
          <div class="mo-campo">
            <label for="teamSize" data-uguale>{f.persone.etichetta}</label>
            <select {...campo('teamSize')} name="teamSize" required>
              <option value="">{f.persone.vuoto}</option>
              {f.persone.opzioni.map((o) => <option value={o}>{o}</option>)}
            </select>
            <p class="mo-errore" id="err-teamSize" hidden>{f.persone.errore}</p>
          </div>

          <fieldset class="mo-campo mo-largo mo-scelte" id="urgentProblem" aria-describedby="aiuto-urgentProblem err-urgentProblem">
            <legend data-uguale>{f.priorita.etichetta}</legend>
            <p class="mo-aiuto" id="aiuto-urgentProblem" data-uguale>{f.priorita.aiuto}</p>
            <div class="mo-opzioni">
              {f.priorita.opzioni.map((o) => (
                <label class="mo-opzione">
                  <input type="checkbox" name="urgentProblem" value={o.valore} />
                  <span data-uguale>{o.testo}</span>
                </label>
              ))}
            </div>
            <p class="mo-errore" id="err-urgentProblem" hidden>{f.priorita.errore}</p>
          </fieldset>

          <div class="mo-campo mo-largo">
            <label for="dailyEmailVolume" data-uguale>{f.volume.etichetta}</label>
            <input {...campo('dailyEmailVolume')} name="dailyEmailVolume" type="text" placeholder={f.volume.segnaposto} required />
            <p class="mo-errore" id="err-dailyEmailVolume" hidden>{f.volume.errore}</p>
          </div>
          <div class="mo-campo mo-largo">
            <label for="currentTools" data-uguale>{f.strumenti.etichetta}</label>
            <textarea {...campo('currentTools')} name="currentTools" rows="3" placeholder={f.strumenti.segnaposto} required></textarea>
            <p class="mo-errore" id="err-currentTools" hidden>{f.strumenti.errore}</p>
          </div>

          <div class="mo-campo mo-largo mo-consenso">
            <label class="mo-opzione">
              <input type="checkbox" id="consenso" name="consenso" aria-describedby="err-consenso" required />
              <span>{f.consenso.prima} <a href="/privacy-policy.html" target="_blank" rel="noopener">{f.consenso.link}</a> {f.consenso.dopo}</span>
            </label>
            <p class="mo-errore" id="err-consenso" hidden>{f.consenso.errore}</p>
          </div>
        </div>

        <div class="mo-invio">
          <button type="submit" class="btn btn-primario" data-testo={f.pulsante} data-invio={f.invio} data-modificato="25/11">{f.pulsante}</button>
          <p class="mo-sotto" data-uguale>{f.sotto}</p>
        </div>
        <p class="mo-esito mo-esito-errore" role="alert" hidden data-diagnosi-errore data-uguale>{f.errore}</p>
      </form>

      <div class="mo-fatto" hidden data-diagnosi-fatto>
        <p class="mo-fatto-titolo" tabindex="-1" data-uguale>{f.riuscito}</p>
        <ul class="mo-fatto-passi">
          {f.dopo.map((t) => <li data-uguale>{t}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <div id="faq" class="contenitore faq">
    <div class="faq-testa">
      <h2 class="faq-titolo">Domande frequenti</h2>
      <p class="faq-sottotitolo">{faqSottotitolo}</p>
    </div>
    <div class="faq-elenco">
      {faq.map((f) => (
        <details class="faq-voce">
          <summary>{f.d}</summary>
          <p>{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  import '../../scripts/diagnosi';
</script>
