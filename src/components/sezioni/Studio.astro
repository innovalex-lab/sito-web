---
// Tutto lo studio in un posto. Titolo e, sotto, il sottotesto. Poi un giro guidato delle sei funzioni (dal 27/11/2026,
// al posto della griglia di sei riquadri): una funzione alla volta, con un solo palco per il suo frammento d'interfaccia.
//   Desktop (da 1024 px): a sinistra l'elenco delle sei funzioni, aperta solo quella attiva (titolo e testo), con una
//   linea oro che si riempie nel tempo della funzione; a destra il palco con il frammento.
//   Telefono e tablet: il palco in alto, sotto la funzione attiva, poi indietro, sei tacche, avanti e pausa.
// Il giro parte da solo quando la sezione è sullo schermo, 3 secondi per funzione (--durata in sezioni.css), e si
// ferma con il puntatore sopra, con il fuoco dentro e fuori dallo schermo. Indietro, avanti, una tacca o un titolo:
// si va lì e il giro si ferma; il pulsante di pausa lo fa ripartire. Con movimento ridotto non parte mai da solo.
// Senza JavaScript: le sei funzioni aperte una sotto l'altra, il palco con la prima.
// I frammenti sono lastre con lo stesso materiale della scena e dei benefici, stilizzati e parziali. Dati fittizi.
// Pratiche mostra la scena del beneficio 3 (la pipeline), che si anima entrando. Lo stato di ogni funzione viene
// da src/content/funzioni.ts.
import ScenaPipeline from '../filo/ScenaPipeline.astro';
import { studio, stato } from '../../content/funzioni';
import { produzione } from '../../content/verifica';

const blocchi = studio.map((b) => ({ ...b, stato: stato(b.funzioni) }));

// Tre soci finti. Il valore è una barra relativa, senza cifre in euro.
const soci = [
  { sigla: 'LF', nome: 'Avv. Laura Ferri', originate: 14, gestite: 22, valore: 0.88 },
  { sigla: 'MC', nome: 'Avv. Marco Conti', originate: 9, gestite: 17, valore: 0.64 },
  { sigla: 'ES', nome: 'Avv. Elena Sarti', originate: 5, gestite: 12, valore: 0.42 },
];
---
<section id="studio" class="studio" aria-labelledby="t-studio">
  <div class="contenitore">
    <div class="studio-testa">
      <h2 id="t-studio" class="sezione-titolo">Tutto lo studio in un posto.</h2>
      <p class="studio-intro">Quello che qualifichi dalla posta alimenta il resto: pratiche, clienti, scadenze e team.</p>
    </div>

    <div class="giro" data-giro role="region" aria-roledescription="carosello" aria-label="Le sei funzioni dello studio">
      <div class="giro-palco">
        {blocchi.map((b, i) => (
          <div id={`studio-${b.id}`} class:list={['giro-scena', 'blocco-palco', `scena-${b.id}`]} data-attivo={i === 0 ? '' : undefined}>
            {b.id === 'pratiche' ? (
              <ScenaPipeline class="blocco-pipeline" />
            ) : (
            <div class="lastra lastra-libera blocco-lastra" data-ui aria-hidden="true">
              <div class="vetro" aria-hidden="true"></div>
              <div class="carta mini">
                {b.id === 'cliente' && (
                  <div class="mini-avviso">
                    <p class="ma-fase"><span class="ma-da">Istruttoria</span><span class="ma-freccia"></span><span class="ma-a">Diffida inviata</span></p>
                    <p class="ma-messaggio">Buongiorno, la diffida a Edilvetta è partita oggi. Può caricare qui la quarta fattura.</p>
                    <span class="ma-link">Carica i documenti</span>
                  </div>
                )}
                {b.id === 'scadenze' && (
                  <div class="mini-scadenza">
                    <span class="ms-data"><b>27</b>nov</span>
                    <span class="ms-testo"><b>Termine della diffida</b><small>Trovata nella mail di Marta Rossi</small></span>
                    <span class="ms-azioni"><span class="ms-si">Conferma</span><span class="ms-no">Rifiuta</span></span>
                  </div>
                )}
                {b.id === 'soci' && (
                  <div class="mini-soci">
                    <span class="vs-testa"><span>Socio</span><span>Originate</span><span>Gestite</span></span>
                    {soci.map((s, i) => (
                      <span class:list={['vs-riga', i === 0 && 'vs-primo']}>
                        <span class="vs-chi"><span class="vs-sigla">{s.sigla}</span><b>{s.nome}</b></span>
                        <span class="vs-num">{s.originate}</span>
                        <span class="vs-num">{s.gestite}</span>
                        <span class="vs-barra"><span style={`width:${s.valore * 100}%`}></span></span>
                      </span>
                    ))}
                    <span class="vs-piede">Valore generato</span>
                  </div>
                )}
                {b.id === 'team' && (
                  <div class="mini-team">
                    {[
                      ['SL', 'Sara Lombrici', 0.82],
                      ['PN', 'Paolo Neri', 0.55],
                      ['GM', 'Giulia Moro', 0.34],
                    ].map(([sigla, nome, carico]) => (
                      <span class="tm-riga">
                        <span class="tm-sigla">{sigla}</span>
                        <span class="tm-nome">{nome}</span>
                        <span class="tm-barra"><span style={`width:${Number(carico) * 100}%`}></span></span>
                      </span>
                    ))}
                  </div>
                )}
                {b.id === 'crm' && (
                  <div class="mini-crm">
                    <span class="mc-passo">Primo contatto</span>
                    <span class="mc-passo">Incontro</span>
                    <span class="mc-passo mc-ora">Incarico</span>
                    <span class="mc-passo mc-pratica">Pratica aperta</span>
                  </div>
                )}
              </div>
            </div>
            )}
          </div>
        ))}
      </div>

      <ol class="giro-voci">
        {blocchi.map((b, i) => (
          <li class="giro-voce" data-attivo={i === 0 ? '' : undefined}>
            <h3 class="giro-titolo blocco-titolo">
              <button type="button" class="giro-scegli" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`giro-testo-${b.id}`}>{b.titolo}</button>
            </h3>
            <div id={`giro-testo-${b.id}`} class="giro-testo">
              <div>
                <p class="blocco-testo">{b.testo}</p>
                {!produzione && b.stato !== 'attiva' && (
                  <p class="avviso-anteprima">Avviso di anteprima: funzione {b.stato}, non pubblicabile come disponibile.</p>
                )}
              </div>
            </div>
            <span class="giro-tempo" aria-hidden="true"></span>
          </li>
        ))}
      </ol>

      <div class="giro-comandi">
        <button type="button" class="giro-tasto" data-giro-indietro aria-label="Funzione precedente">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
        <span class="giro-tacche">
          {blocchi.map((b, i) => (
            <button type="button" class="giro-tacca" data-giro-tacca={i} aria-label={`${b.titolo}, ${i + 1} di ${blocchi.length}`} aria-current={i === 0 ? 'true' : undefined}></button>
          ))}
        </span>
        <button type="button" class="giro-tasto" data-giro-avanti aria-label="Funzione successiva">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
        <button type="button" class="giro-tasto giro-pausa" data-giro-pausa aria-label="Ferma il giro delle funzioni" hidden>
          <svg class="gp-ferma" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M7.5 5v10M12.5 5v10" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          <svg class="gp-avvia" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M7 5.2v9.6L14.6 10Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/studio';
</script>
