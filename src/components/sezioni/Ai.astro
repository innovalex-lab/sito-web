---
// AI e automazioni. Statica, con due micro animazioni all'ingresso (isole Motion). Invariata dalla fase 3.
// Sotto, nella stessa fascia scura, la compliance del sito attuale (fase 4: sostituisce le quattro frasi di sicurezza).
import { ai, stato } from '../../content/funzioni';
import { compliance } from '../../content/storia';
import { produzione } from '../../content/verifica';
import { LeggeMail, Archivia } from './AiScene';

const colonne = [
  { id: 'legge', titolo: 'Cosa legge l’AI per te', righe: ai.legge },
  { id: 'da-solo', titolo: 'Cosa succede da solo', righe: ai.daSolo },
];
---
<section id="ai" class="ai" aria-labelledby="t-ai">
  <div class="contenitore ai-interno">
    <h2 id="t-ai" class="ai-titolo">{ai.titolo}</h2>

    <div class="ai-colonne">
      {colonne.map((c) => (
        <div class:list={['ai-colonna', `ai-${c.id}`]}>
          <div class="ai-palco">
            {c.id === 'legge' ? (
              <LeggeMail client:visible={{ rootMargin: '300px' }} />
            ) : (
              <Archivia client:visible={{ rootMargin: '300px' }} />
            )}
          </div>
          <h3 class="ai-sottotitolo">{c.titolo}</h3>
          <ul class="ai-elenco">
            {c.righe.map((r) => (
              <li>
                {r.testo}
                {!produzione && stato(r.funzioni) !== 'attiva' && (
                  <span class="avviso-anteprima avviso-scuro">Avviso di anteprima: funzione {stato(r.funzioni)}.</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="compliance" class="compliance" aria-labelledby="t-compliance">
  <div class="contenitore compliance-interno">
    <h2 id="t-compliance" class="compliance-titolo" data-uguale>{compliance.titolo[0]}<br />{compliance.titolo[1]}</h2>
    <ul class="compliance-voci">
      {compliance.voci.map((v) => (
        <li>
          <h3 class="cv-nome">{v.nome}</h3>
          <p class="cv-testo">{v.testo}</p>
        </li>
      ))}
    </ul>
    <p class="compliance-dpa" data-uguale>{compliance.dpa}</p>
  </div>
</section>
