---
// 7. Riepilogo: al posto della sezione AI (decisione di Federico del 25/11/2026, docs/PIANO-STORYLINE.md).
// Tipografia e tre icone a tratto, nella fascia scura; sotto, nella stessa fascia, la compliance del sito attuale.
// Ordine di lettura: titolo, testo, tre blocchi, conto in oro, pulsanti. Nessuna animazione. Per un video futuro sopra i tre blocchi c'è lo slot "video":
//   <Riepilogo><video slot="video" ... /></Riepilogo>
// Senza slot non si mostra nulla, nemmeno un segnaposto.
import { riepilogo as r, compliance, prenota } from '../../content/storia';

const conVideo = Astro.slots.has('video');

// Icone dei tre blocchi, disegnate per questa sezione su una griglia di 40 px: solo tratto da 1,5 px,
// giunti e terminazioni tondi, spigoli vivi, nessun fondo. Il disegno parte dal bordo sinistro (x = 1)
// per stare a filo con la parola chiave, e poggia sulla stessa base (y = 38,5).
const icone: Record<string, string[]> = {
  // Orologio: le lancette segnano le due, come le due ore al giorno del conto
  tempo: ['M37.25 20a17.75 17.75 0 1 1-35.5 0a17.75 17.75 0 0 1 35.5 0z', 'M19.5 10v10l6.25-3.6', 'M19.5 5.5v1.75M34 20h-1.75M19.5 34.5v-1.75M5 20h1.75'],
  // Pagina del report con l'angolo piegato e tre barre che salgono
  fatturato: ['M1.75 2.25h18.5l8 8v27.5H1.75z', 'M20.25 2.25v8h8', 'M8.25 31.5v-5M15 31.5v-9.5M21.75 31.5v-14', 'M8.25 10.25h5.5'],
  // Tre cartelle di pratica una dietro l'altra, in ordine
  organizzazione: ['M1.75 37.75v-20.5h10l3 3.5h14v17z', 'M5.75 17.25v-5h10l3 3.5h14v17h-4', 'M9.75 12.25v-5h10l3 3.5h14v17h-4'],
};
---
<section id="riepilogo" class="riepilogo" aria-labelledby="t-riepilogo">
  <div class="contenitore riepilogo-interno">
    <h2 id="t-riepilogo" class="riepilogo-titolo"><span>{r.titolo[0]}</span> <span>{r.titolo[1]}</span></h2>
    <p class="riepilogo-testo">{r.testo.testo}</p>

    {conVideo && (
      <div class="riepilogo-video">
        <slot name="video" />
      </div>
    )}

    <ul class="riepilogo-blocchi">
      {r.blocchi.map((b) => (
        <li class="riepilogo-blocco">
          <svg class="rb-icona" viewBox="0 0 40 40" width="40" height="40" fill="none" aria-hidden="true" focusable="false">
            {icone[b.id].map((d) => <path d={d} />)}
          </svg>
          <h3 class="rb-titolo"><span class="rb-chiave">{b.chiave}<span class="rb-due-punti">:</span></span> <span class="rb-resto">{b.resto}</span></h3>
          <p class="rb-testo">{b.testo}</p>
        </li>
      ))}
    </ul>

    <p class="riepilogo-chiusura">
      {r.chiusura.map((parte, i) => <>{i > 0 && ' '}<span>{parte}</span></>)}
    </p>

    <p class="riepilogo-azioni">
      <a class="btn btn-chiaro" href={r.calcola.href} data-cta="riepilogo-calcola">{r.calcola.testo}</a>
      <a class="btn btn-oro" href="#contatti" data-cta="riepilogo-diagnosi">{prenota}</a>
    </p>
  </div>
</section>

<section id="compliance" class="compliance" aria-labelledby="t-compliance">
  <div class="contenitore compliance-interno">
    <h2 id="t-compliance" class="compliance-titolo" data-uguale>{compliance.titolo[0]}<br />{compliance.titolo[1]}</h2>
    <ul class="compliance-voci">
      {compliance.voci.map((v) => (
        <li>
          <h3 class="cv-nome">{v.nome}</h3>
          <p class="cv-testo">{v.testo}</p>
        </li>
      ))}
    </ul>
    <p class="compliance-dpa" data-uguale>{compliance.dpa}</p>
  </div>
</section>
