---
// 11. Chi siamo. Statica. Il caso SCLN è passato in Risultati reali (fase 4).
// Ritratti 4:5 in public/team/, rifatti dagli originali con scripts/ritratti.py: stesso fondo, occhi alla
// stessa altezza, testa della stessa grandezza. Stessa cornice e stessa misura per tutti e due a ogni larghezza:
// 240 x 300 da 560 px in su, 104 x 130 sotto. AVIF e WebP a 1x e 2x, senza metadati.
import { persone } from '../../content/funzioni';
import { chiSiamo, prenota } from '../../content/storia';

const larghezze = [104, 208, 240, 480];
const srcset = (foto: string, formato: string) => larghezze.map((l) => `/team/${foto}-${l}.${formato} ${l}w`).join(', ');
const sizes = '(min-width: 560px) 240px, 104px';
---
<section id="chi-siamo" class="chi" aria-labelledby="t-chi">
  <span id="founder" class="ancora-vecchia" aria-hidden="true"></span>
  <div class="contenitore chi-interno">
    <div class="chi-testa">
      <h2 id="t-chi" class="sezione-titolo">{chiSiamo.titolo}</h2>
      <a class="btn btn-primario chi-pulsante" href="#contatti" data-uguale>{prenota}</a>
    </div>

    <div class="chi-persone">
      {persone.map((p, i) => (
        <div class:list={['persona', i === 0 ? 'persona-fondatore' : 'persona-cofondatore']}>
          <picture class="ritratto">
            <source type="image/avif" srcset={srcset(p.foto, 'avif')} sizes={sizes} />
            <source type="image/webp" srcset={srcset(p.foto, 'webp')} sizes={sizes} />
            <img src={`/team/${p.foto}-240.webp`} width="240" height="300" alt={`Ritratto di ${p.nome}`} loading="lazy" decoding="async" />
          </picture>
          <div class="persona-testa">
            <h3 class="persona-nome">{p.nome}</h3>
            <p class="persona-ruolo">{p.ruolo}</p>
          </div>
          <div class="persona-testo">
            {p.testo.map((t) => <p data-uguale={i === 0 ? '' : undefined}>{t}</p>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
