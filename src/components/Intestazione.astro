---
// Voci del menu e pulsante come sul sito attuale (docs/PIANO-STORYLINE.md, Menu).
import { menu, menuPulsante } from '../content/storia';

interface Props {
  /** Home: intestazione fissa allo scorrimento, con il pulsante sempre visibile anche su telefono. */
  fissa?: boolean;
}
const { fissa = false } = Astro.props;

// Fuori dalla home le ancore puntano alla home.
const base = fissa ? '' : '/';
const voci = menu.map((v) => ({ ...v, href: base + v.href }));
const pulsante = { ...menuPulsante, href: base + menuPulsante.href };
---
<a class="salta" href="#contenuto">Vai al contenuto</a>
<header class:list={['z-40 bg-bianco', fissa ? 'barra-fissa sticky top-0' : 'relative']} data-barra>
  <div class="contenitore flex h-barra items-center justify-between gap-3 lg:gap-6">
    <div class="relative shrink-0">
      <a href="/" class="block" aria-label="INNOVALEX, torna alla home">
        <img src="/brand/innovalex-logo.svg" width="164" height="50" alt="" class="logo-barra block h-[50px] w-[164px]" />
      </a>
    </div>

    <nav aria-label="Principale" class="hidden xl:block">
      <ul class="flex items-center gap-6">
        {voci.map((v) => <li><a class="voce-menu" href={v.href} data-uguale>{v.nome}</a></li>)}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a class:list={['btn btn-primario btn-compatto shrink-0', fissa ? 'inline-flex' : 'hidden xl:inline-flex']} href={pulsante.href} data-uguale>{pulsante.nome}</a>

      <details class="menu-mobile xl:hidden" data-menu>
        <summary>
          <span class="quando-chiuso">Menu</span>
          <span class="quando-aperto">Chiudi</span>
        </summary>
        <nav aria-label="Menu principale" class="absolute inset-x-0 top-full bg-bianco shadow-[0_12px_24px_rgb(20_26_61/0.16)]">
          <ul class="contenitore py-2">
            {voci.map((v) => (
              <li><a class="flex min-h-12 items-center text-corpo font-medium text-inchiostro" href={v.href}>{v.nome}</a></li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Menu mobile: si chiude con Esc (il fuoco torna sul pulsante) e quando si sceglie una voce.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-menu]')) {
    const pulsante = menu.querySelector('summary')!;
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      pulsante.focus();
    });
    menu.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>
