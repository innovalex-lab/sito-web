---
import Base from '../../layouts/Base.astro';
import Intestazione from '../../components/Intestazione.astro';
import SegnapostoPannello from '../../components/SegnapostoPannello.astro';
import { primaSchermata as c } from '../../content/prima-schermata';
---
<Base title="Direzione B | INNOVALEX" anteprima>
  <Intestazione />
  <main id="contenuto" class="min-h-[calc(100dvh-var(--spacing-barra))] bg-profondo">
    <section aria-labelledby="titolo">
      <div class="bg-carta"><div class="contenitore griglia items-end gap-y-6 pt-10 pb-10 lg:pt-14 lg:pb-12">
        <h1 id="titolo" class="col-span-12 font-serif text-titolo font-semibold text-inchiostro lg:col-span-7">{c.titolo}</h1>
        <div class="col-span-12 lg:col-span-5 lg:col-start-8">
          <p class="text-corpo text-inchiostro">{c.testo}</p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a class="btn btn-primario" href={c.principale.href}>{c.principale.testo}</a>
            <a class="btn btn-secondario" href={c.secondario.href}>{c.secondario.testo}</a>
          </div>
        </div>
      </div></div>

      <div class="relative pb-margine">
        <div class="absolute inset-x-0 top-0 h-1/3 bg-carta"></div>
        <div class="contenitore griglia relative">
          <div class="col-span-12 lg:col-span-10 lg:col-start-2">
            <SegnapostoPannello class="bg-bianco" />
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
