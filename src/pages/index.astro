---
// Home, fase 4: la storyline del sito attuale (index.html sul ramo main) illustrata dalla grafica nuova.
// Ordine e testi: docs/PIANO-STORYLINE.md. Testi in src/content/storia.ts, stato delle funzioni in src/content/funzioni.ts.
import Base from '../layouts/Base.astro';
import Intestazione from '../components/Intestazione.astro';
import Eroe from '../components/sezioni/Eroe.astro';
import Problema from '../components/sezioni/Problema.astro';
import Calcolatore from '../components/sezioni/Calcolatore.astro';
import ComeFunziona from '../components/sezioni/ComeFunziona.astro';
import Sistemi from '../components/sezioni/Sistemi.astro';
import Studio from '../components/sezioni/Studio.astro';
import Riepilogo from '../components/sezioni/Riepilogo.astro';
import Risultati from '../components/sezioni/Risultati.astro';
import Diagnosi from '../components/sezioni/Diagnosi.astro';
import ChiSiamo from '../components/sezioni/ChiSiamo.astro';
import PiePagina from '../components/sezioni/PiePagina.astro';
import { fotoEroe } from '../content/foto-eroe';
import { verificaPerBuild, produzione } from '../content/verifica';
import serifTitolo from '../fonts/filo/serif-latino.woff2?url';
import '../styles/filo.css';
import '../styles/sezioni.css';
import '../styles/storia.css';

// Verifica dei contenuti: in produzione ferma la build, in anteprima mostra gli avvisi in fondo alla pagina.
const avvisi = verificaPerBuild();
---
<Base sito fontPropri>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" imagesrcset={fotoEroe.avif} imagesizes={fotoEroe.sizes} fetchpriority="high" />
    <link rel="preload" href={serifTitolo} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </Fragment>

  <div class="pagina-filo">
    <Intestazione fissa />

    <main id="contenuto">
      <Eroe />
      <Problema />
      <Calcolatore />
      <ComeFunziona />
      <Sistemi />
      <Studio />
      <Riepilogo />
      <Risultati />
      <Diagnosi />
      <ChiSiamo />
    </main>
    <PiePagina />

    {!produzione && avvisi.length > 0 && (
      <aside class="avvisi-anteprima" aria-label="Avvisi dell'anteprima">
        <div class="contenitore">
          <p><b>Avvisi dell’anteprima ({avvisi.length}).</b> In produzione la build si ferma finché non sono risolti.</p>
          <ul>
            {avvisi.map((a) => <li>{a.dove}: {a.problema}</li>)}
          </ul>
        </div>
      </aside>
    )}
  </div>
</Base>

<script>
  import '../scripts/filo';
</script>
