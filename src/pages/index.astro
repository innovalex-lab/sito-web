---
// Home, fase 4: la storyline del sito attuale (index.html sul ramo main) illustrata dalla grafica nuova.
// Ordine e testi: docs/PIANO-STORYLINE.md. Testi in src/content/storia.ts, stato delle funzioni in src/content/funzioni.ts.
import Base from '../layouts/Base.astro';
import Intestazione from '../components/Intestazione.astro';
import Eroe from '../components/sezioni/Eroe.astro';
import Problema from '../components/sezioni/Problema.astro';
import Calcolatore from '../components/sezioni/Calcolatore.astro';
import ComeFunziona from '../components/sezioni/ComeFunziona.astro';
import Sistemi from '../components/sezioni/Sistemi.astro';
import Studio from '../components/sezioni/Studio.astro';
import Riepilogo from '../components/sezioni/Riepilogo.astro';
import Risultati from '../components/sezioni/Risultati.astro';
import Diagnosi from '../components/sezioni/Diagnosi.astro';
import ChiSiamo from '../components/sezioni/ChiSiamo.astro';
import { chiSiamoInPagina } from '../content/storia';
import PiePagina from '../components/sezioni/PiePagina.astro';
import { fotoEroe } from '../content/foto-eroe';
import { verificaPerBuild, produzione } from '../content/verifica';
import serifTitolo from '../fonts/filo/serif-latino.woff2?url';
import '../styles/filo.css';
import '../styles/sezioni.css';
import '../styles/storia.css';

// Verifica dei contenuti: in produzione ferma la build, in anteprima mostra gli avvisi in fondo alla pagina.
const avvisi = verificaPerBuild();
---
<Base sito fontPropri>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" imagesrcset={fotoEroe.avif} imagesizes={fotoEroe.sizes} fetchpriority="high" />
    <link rel="preload" href={serifTitolo} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {!produzione && (
      <Fragment>
        {/* Anteprima del font dei titoli, solo fuori produzione: con ?titoli=classico i titoli passano a EB Garamond.
            Il font (dist/anteprima/titoli/, copiato da astro.config.mjs) si scarica solo quando l'interruttore è attivo. */}
        <script is:inline>if (new URLSearchParams(location.search).get('titoli') === 'classico') document.documentElement.classList.add('titoli-classico')</script>
        <style is:inline>
          @font-face {
            font-family: 'EB Garamond Anteprima';
            font-style: normal;
            font-weight: 400;
            font-display: swap;
            src: url('/anteprima/titoli/eb-garamond-latin-400-normal.woff2') format('woff2');
          }
          html.titoli-classico {
            --font-serif: 'EB Garamond Anteprima', Georgia, serif;
          }
          /* Su telefono e tablet sta in fondo alla pagina, per non coprire il testo; da 1024 px resta in basso a destra */
          .interruttore-titoli {
            display: flex;
            width: fit-content;
            margin: 1rem;
            gap: 0.75rem;
            align-items: center;
            padding: 0.5rem 0.75rem;
            border: 1px solid #d8d3c7;
            border-radius: 3px;
            background: #fff;
            color: #1e2656;
            font-size: 0.8125rem;
            line-height: 1.3;
          }
          @media (min-width: 1024px) {
            .interruttore-titoli {
              position: fixed;
              right: 1rem;
              bottom: 1rem;
              z-index: 60;
              margin: 0;
            }
          }
          .interruttore-titoli a {
            color: #454b6b;
            text-decoration: none;
          }
          .interruttore-titoli a[aria-current] {
            color: #1e2656;
            font-weight: 600;
            text-decoration: underline;
            text-decoration-color: #9e7a35;
            text-underline-offset: 0.25em;
          }
        </style>
      </Fragment>
    )}
  </Fragment>

  <div class="pagina-filo">
    <Intestazione fissa />

    <main id="contenuto">
      <Eroe />
      <Problema />
      <Calcolatore />
      <ComeFunziona />
      <Sistemi />
      <Studio />
      <Riepilogo />
      <Risultati />
      <Diagnosi />
      {chiSiamoInPagina && <ChiSiamo />}
    </main>
    <PiePagina />

    {!produzione && (
      <nav class="interruttore-titoli" aria-label="Font dei titoli, solo in anteprima">
        <span>Titoli</span>
        <a href="./" data-titoli="moderno">Source Serif 4</a>
        <a href="?titoli=classico" data-titoli="classico">EB Garamond</a>
        <script is:inline>(function () { var c = document.documentElement.classList.contains('titoli-classico') ? 'classico' : 'moderno'; document.querySelector('[data-titoli="' + c + '"]').setAttribute('aria-current', 'page'); })()</script>
      </nav>
    )}

    {!produzione && avvisi.length > 0 && (
      <aside class="avvisi-anteprima" aria-label="Avvisi dell'anteprima">
        <div class="contenitore">
          <p><b>Avvisi dell’anteprima ({avvisi.length}).</b> In produzione la build si ferma finché non sono risolti.</p>
          <ul>
            {avvisi.map((a) => <li>{a.dove}: {a.problema}</li>)}
          </ul>
        </div>
      </aside>
    )}
  </div>
</Base>

<script>
  import '../scripts/filo';
</script>
